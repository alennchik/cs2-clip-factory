# Copy to .env (`clipfactory init` does it) and fill in. Never commit .env.

# https://dev.twitch.tv/console/apps -> Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# @BotFather -> /newbot. Chat id: message your bot, then run `clipfactory review chat-id`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe
# YTDLP_BIN=yt-dlp
# CLIPFACTORY_DATA_DIR=data
# CLIPFACTORY_OUT_DIR=out
# CLIPFACTORY_CONFIG=config/streamers.yaml
