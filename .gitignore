# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Secrets — never commit
.env
.env.*
!.env.example

# Permission screenshots contain other people's messages — keep them local (back them up elsewhere)
permissions/

# Media, database and renders (large, regenerated by the pipeline)
data/
out/

# Sponsor media stays local (do not commit downloaded ad binaries)
assets/sponsor/*.webm
assets/sponsor/*.mov
assets/sponsor/*.mp4

# macOS
.DS_Store
